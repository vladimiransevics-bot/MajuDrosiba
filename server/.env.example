# Copy to .env and fill in real values. Never commit .env to git.

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
SITE_ORIGIN=https://majudrosiba.lv

# ── Admin panel ─────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_strong_password

# ── Database (optional — default: server/majudrosiba.sqlite) ────────────
# DB_PATH=/home/username/majudrosiba/server/majudrosiba.sqlite

# ── Email — contact form notifications ──────────────────────────────────
EMAIL_TO=info@majudrosiba.lv

# Option A: beget mail (SMTP) — recommended
EMAIL_HOST=mail.beget.com
EMAIL_PORT=465
EMAIL_USER=info@majudrosiba.lv
EMAIL_PASS=your_beget_email_password

# Option B: Gmail App Password — comment out EMAIL_HOST above, then:
# EMAIL_HOST=
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=xxxx_xxxx_xxxx_xxxx   # 16-char App Password from myaccount.google.com
